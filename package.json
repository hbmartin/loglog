{
  "name": "loglog",
  "description": "Local-first poop tracker for dogs (and hairless apes). Purina fecal scoring, no backend.",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.145.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router-devtools": "^1.145.7",
    "@tanstack/router-plugin": "^1.145.10",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "shadcn": "^3.6.3",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@^7.3.0",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@^7.3.0"
    }
  }
}
